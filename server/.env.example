# 运行环境
ENV=dev

# 数据库
DATABASE_URL=postgresql+psycopg://arya:arya_dev@localhost:5432/arya_handcraft
REDIS_URL=redis://localhost:6379/0

# JWT(在 conda 的 fastapi 环境中执行以下任一命令生成,不要使用示例值):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 微信小程序(个人主体)——真实值填 server/.env(不入库),此处留空
WX_APP_ID=wxa8c423327b9452ec
WX_APP_SECRET=change_me_wechat_app_secret

# 联系店主二维码(留空则前端用自己的 static/wechat-qr.png)
CONTACT_QR_URL=

# 大模型(DeepSeek,OpenAI 兼容)——真实值填 server/.env
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=change_me_deepseek_api_key
LLM_MODEL=deepseek-v4-flash

# 管理后台初始密码
ADMIN_INIT_PASSWORD=change_me_admin_password
